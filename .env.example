# PostgreSQL
POSTGRES_DB=telemedecineapi
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_database_password
DB_URL=jdbc:postgresql://postgres:5432/telemedecineapi
DB_USERNAME=postgres
DB_PASSWORD=change_me_database_password

# Spring security and bootstrap (JWT secret must be at least 32 characters)
JWT_SECRET=change_me_to_a_random_secret_at_least_32_characters
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
MFA_CHALLENGE_EXPIRATION_MINUTES=5
MFA_MAX_ATTEMPTS=5

# Password-reset email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=your-smtp-app-password
FRONTEND_URL=http://localhost
PASSWORD_RESET_EXPIRATION_MINUTES=20
PASSWORD_RESET_REQUEST_COOLDOWN_SECONDS=60

# External media and meetings
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# AI service
GROQ_API_KEY=change_me_groq_api_key
HF_TOKEN=
AI_SERVICE_URL=http://ai-service:8000
EMBED_MODEL=sentence-transformers/all-mpnet-base-v2
GROQ_MODEL=llama-3.3-70b-versatile
SUMMARY_MODEL=llama-3.1-8b-instant
GROQ_TEMPERATURE=0.2
RECENT_TURNS=2
SUMMARY_MAX_CHARS=1200

# Optional host ports for local debugging
FRONTEND_PORT=80
BACKEND_PORT=8080
AI_PORT=8000
POSTGRES_PORT=5432
